{
  "name": "qpr_non_ideal_50hz",
  "module": "qpr",
  "mode": "non_ideal",
  "runner": {
    "executable": "../../../build/host-tools/tools/freq_response/voloop_freq_response_runner"
  },
  "paths": {
    "frequencies": "../../../build/tools/freq_response/frequencies.txt",
    "raw_csv": "../../../build/tools/freq_response/qpr_non_ideal_50hz_raw.csv"
  },
  "measurement": {
    "sample_rate_hz": 10000,
    "input_amplitude": 1.0,
    "warmup_cycles": 20,
    "measure_cycles": 10,
    "min_samples_per_cycle": 32,
    "max_samples_per_point": 2000000,
    "output_abs_limit": 1000000,
    "gain_floor": 1e-12
  },
  "params": {
    "qpr-kp": 0.0,
    "qpr-kr": 1.0,
    "qpr-resonant-hz": 50.0,
    "qpr-cutoff-hz": 5.0
  }
}
