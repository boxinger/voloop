{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "host-lib",
      "inherits": "host-base",
      "cacheVariables": {
        "VOLOOP_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "host-tests",
      "inherits": "host-base",
      "cacheVariables": {
        "VOLOOP_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "host-tools",
      "inherits": "host-base",
      "cacheVariables": {
        "VOLOOP_BUILD_TESTS": "OFF",
        "VOLOOP_BUILD_DOCS": "OFF",
        "VOLOOP_BUILD_TOOLS": "ON"
      }
    },
    {
      "name": "host-all",
      "inherits": "host-base",
      "cacheVariables": {
        "VOLOOP_BUILD_TESTS": "ON",
        "VOLOOP_BUILD_TOOLS": "ON",
        "VOLOOP_BUILD_DOCS": "OFF"
      }
    },
    {
      "name": "host-debug",
      "inherits": "host-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VOLOOP_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "docs",
      "inherits": "host-base",
      "binaryDir": "${sourceDir}/build/docs/cmake",
      "cacheVariables": {
        "VOLOOP_BUILD_TESTS": "OFF",
        "VOLOOP_BUILD_DOCS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-lib",
      "configurePreset": "host-lib",
      "targets": [
        "voloop"
      ]
    },
    {
      "name": "host-tests",
      "configurePreset": "host-tests"
    },
    {
      "name": "host-tools",
      "configurePreset": "host-tools"
    },
    {
      "name": "host-all",
      "configurePreset": "host-all"
    },
    {
      "name": "host-debug",
      "configurePreset": "host-debug"
    },
    {
      "name": "docs",
      "configurePreset": "docs",
      "targets": [
        "voloop_docs"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "host-tests",
      "configurePreset": "host-tests",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "host-all",
      "configurePreset": "host-all",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
