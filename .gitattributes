# Normalize text files.
* text=auto

# Source code: force LF line endings.
*.c      text eol=lf
*.h      text eol=lf
*.s      text eol=lf
*.S      text eol=lf
*.ld     text eol=lf
*.cmake  text eol=lf
CMakeLists.txt text eol=lf

# Documentation and configuration.
*.md     text eol=lf
*.txt    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.xml    text eol=lf

# Windows scripts may use CRLF.
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Unix scripts should use LF.
*.sh     text eol=lf

# Binary files.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.pdf    binary
*.zip    binary
*.7z     binary
*.bin    binary
*.elf    binary
*.o      binary
*.a      binary
*.so     binary
*.dll    binary
*.exe    binary